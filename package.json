		"decor:sync": "bun scripts/sync-decor.ts",
		"engine:build": "bun scripts/build-engine.ts",
		"lang:sync": "bun scripts/sync-lang.ts",
		"villagers:sync": "bun scripts/sync-villagers.ts",
		"enchanting:sync": "bun scripts/sync-enchanting.ts",
		"enchanting-scene:sync": "bun scripts/sync-enchanting-scene.ts",
		"related:sync": "bun scripts/sync-related.ts",
		"sync": "bun scripts/sync-all.ts"
	},
	"dependencies": {
		"@base-ui/react": "^1.8.0",
